{
  "name": "tydom-client",
  "version": "0.16.0",
  "description": "Easily manage Tydom hardware by Delta Dore from Node.js",
  "author": "Olivier Louvignes <olivier@mgcrea.io>",
  "repository": "github:mgcrea/node-tydom-client",
  "license": "MIT",
  "engines": {
    "node": "^22 || ^24 || ^26"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint src/ test/",
    "lint:fix": "oxlint --fix src/ test/",
    "format": "oxfmt --write src/ test/",
    "format:check": "oxfmt --check src/ test/",
    "check": "tsc --noEmit",
    "spec": "NODE_TLS_REJECT_UNAUTHORIZED=0 vitest --run",
    "coverage": "NODE_TLS_REJECT_UNAUTHORIZED=0 vitest --run --coverage",
    "watch": "NODE_TLS_REJECT_UNAUTHORIZED=0 vitest",
    "start": "tsx src/cli/tydom.ts",
    "cli": "DEBUG=tydom-client tsx --inspect --watch src/cli/tydom.ts",
    "test": "pnpm run lint && pnpm run check && pnpm run spec && pnpm run format:check",
    "release": "release-it",
    "prepublishOnly": "pnpm run test && pnpm run build"
  },
  "bin": {
    "tydom": "./dist/cli/tydom.mjs"
  },
  "dependencies": {
    "debug": "^4.4.3",
    "http-parser-js": "^0.5.10",
    "kolorist": "^1.8.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "^24.0.1",
    "@tsconfig/strictest": "^2.0.8",
    "@types/debug": "^4.1.13",
    "@types/node": "^22",
    "@types/ws": "^8.18.1",
    "@types/yargs": "^17.0.35",
    "@vitest/coverage-v8": "^4.1.11",
    "msw": "^2.15.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "release-it": "^21.0.2",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "yargs": "^18.1.0"
  },
  "packageManager": "pnpm@11.25.0",
  "imports": {
    "#*": "./src/*.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
