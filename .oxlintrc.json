{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "promise", "import", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "env": {
    "node": true,
    "es2023": true
  },
  "rules": {
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "error",
    "unicorn/prefer-node-protocol": "error",
    "no-console": "error",
    // The digest-auth challenge/response handshake and reconnect backoff are
    // inherently sequential — parallelising them would be wrong, not faster.
    "no-await-in-loop": "off"
  },
  "overrides": [
    {
      "files": ["test/**/*.ts", "scripts/**/*.ts", "src/cli/**/*.ts"],
      "rules": {
        // stdout is the CLI's product, not a stray debug statement.
        "no-console": "off"
      }
    }
  ],
  "ignorePatterns": ["dist/", "node_modules/", "coverage/"]
}
